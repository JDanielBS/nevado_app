<?xml version="1.0" encoding="utf-8"?>
<!-- Se permite HTTP sin cifrar para dos usos locales: los archivos del mapa (127.0.0.1) y la descarga del
     modelo desde el servidor de la estación, cuya dirección cambia según la red. Android no permite limitar
     la regla a un rango de direcciones. La dirección llega firmada en el pase y el modelo se verifica con
     SHA-256 antes de cargarlo. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
